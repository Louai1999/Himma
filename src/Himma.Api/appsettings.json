{
  "Database": {
    "Provider": "Sqlite",
    "AutoMigrate": false
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=himma.db",
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "himma",
    "Audience": "himma-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Api": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Ai": { "PermitLimit": 20, "WindowSeconds": 3600 }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/himma-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
